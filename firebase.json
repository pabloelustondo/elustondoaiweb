{
  "functions": [
    {
      "source": "functions",
      "codebase": "article-curator",
      "runtime": "nodejs22",
      "ignore": [
        ".local",
        "coverage",
        "node_modules",
        "src/**/*.test.ts"
      ],
      "predeploy": [
        "pnpm --dir \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  }
}
