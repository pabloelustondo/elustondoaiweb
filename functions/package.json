{
  "name": "elustondoai-article-curator-functions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "local:once": "tsx src/local-runner.ts --once",
    "local:twice": "tsx src/local-runner.ts --twice",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json"
  },
  "dependencies": {
    "@langchain/core": "1.2.4",
    "@langchain/google": "0.2.1",
    "fast-xml-parser": "5.10.1",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
