{
  "name": "elustondoaiweb",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "content:refresh": "node --import ./backend/article-curator/node_modules/tsx/dist/loader.mjs scripts/refresh-articles.mjs",
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:preview": "pnpm --dir frontend run preview",
    "frontend:test": "pnpm --dir frontend run test",
    "frontend:lint": "pnpm --dir frontend run lint",
    "frontend:typecheck": "pnpm --dir frontend run typecheck",
    "backend:build": "pnpm --dir backend/article-curator run build",
    "backend:test": "pnpm --dir backend/article-curator run test",
    "backend:lint": "pnpm --dir backend/article-curator run lint",
    "backend:typecheck": "pnpm --dir backend/article-curator run typecheck",
    "curator:build": "pnpm run backend:build",
    "curator:install": "pnpm install --frozen-lockfile --filter elustondoai-article-curator-functions...",
    "curator:local": "pnpm --dir backend/article-curator run local:once",
    "curator:local:twice": "pnpm --dir backend/article-curator run local:twice",
    "curator:test": "pnpm run backend:test",
    "curator:typecheck": "pnpm run backend:typecheck",
    "dev": "pnpm run frontend:dev",
    "preview": "pnpm run frontend:preview",
    "build": "pnpm run frontend:build && pnpm run backend:build",
    "test": "pnpm run frontend:test && pnpm run backend:test",
    "lint": "pnpm run frontend:lint && pnpm run backend:lint",
    "typecheck": "pnpm run frontend:typecheck && pnpm run backend:typecheck"
  }
}
